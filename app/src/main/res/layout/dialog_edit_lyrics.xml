<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A1E"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editar letra manualmente"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvLyricsEditorStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Se guarda en este teléfono y se sincroniza con el servidor."
        android:textColor="#9E9E9E"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/etManualLyrics"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="#2A2A2E"
        android:gravity="top"
        android:hint="Escribe la letra aquí (formato plano o LRC)..."
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#66FFFFFF"
        android:textSize="14sp"
        android:inputType="textMultiLine"
        android:scrollbarStyle="insideInset"
        android:scrollbars="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveManualLyrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Guardar Letra"
        android:textAllCaps="false"
        android:textColor="#000000"
        app:backgroundTint="#1DB954"
        app:cornerRadius="12dp" />

</LinearLayout>
