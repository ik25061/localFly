<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvNewGenreTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo género"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_centerVertical="true" />

        <ImageButton
            android:id="@+id/btnCloseNewGenre"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#AAAAAA" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del género"
        android:textColor="#AAAAAA"
        android:textSize="12sp" />
    <EditText
        android:id="@+id/etGenreName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#222222"
        android:padding="10dp"
        android:hint="Ej.: Rock Clásico"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:textSize="14sp"
        android:maxLines="1"
        android:imeOptions="actionDone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Descripción (opcional, ayuda a la IA)"
        android:textColor="#AAAAAA"
        android:textSize="12sp" />
    <EditText
        android:id="@+id/etGenreDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#222222"
        android:padding="10dp"
        android:hint="Ej.: guitarras eléctricas y baterías potentes"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:textSize="14sp"
        android:maxLines="2"
        android:imeOptions="actionDone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateGenre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear género"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#7C4DFF"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelNewGenre"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#AAAAAA" />
    </LinearLayout>

</LinearLayout>