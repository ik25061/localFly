<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="#15181F"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/tvLibraryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Biblioteca"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="100"
                android:textColor="#0F1115"
                android:textStyle="bold"
                app:icon="@drawable/ic_download"
                app:iconTint="#0F1115"
                app:backgroundTint="#1DB954"
                app:cornerRadius="18dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false" />

            <ImageButton
                android:id="@+id/btnLibraryToPlaylist"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="#1E1E25"
                android:src="@drawable/ic_playlist"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminate="false"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="4dp"
        app:indicatorColor="#1DB954"
        app:trackColor="#333333" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#171B24"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="#171B24">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#202936"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#9EA3AD" />
            </FrameLayout>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Buscar en tu biblioteca"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E93A0"
                android:textSize="14sp"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvSongCountInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 canciones"
            android:textColor="#A8A8AF"
            android:textSize="12sp"
            android:layout_centerVertical="true" />

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLibrarySongs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="0dp"
        android:clipToPadding="false"
        android:background="@android:color/transparent" />

</LinearLayout>