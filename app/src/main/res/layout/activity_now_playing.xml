<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/ivBlurredBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45" />

    <View
        android:id="@+id/backgroundScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_now_playing_scrim" />

    <ImageView
        android:id="@+id/ivPodcastHeader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vPodcastGradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_podcast_scrim"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivPodcastHeader"
        app:layout_constraintTop_toTopOf="@id/ivPodcastHeader" />

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/rlTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/arrow_down_float"
            app:tint="#FFFFFF" />

        <!-- User proposal: Ordering icons at the top right -->
        <LinearLayout
            android:id="@+id/llTopActions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnComments"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_comment"
                app:tint="#FFFFFF" />

            <!-- Karaoke: alterna entre la version original y el instrumental -->
            <ImageButton
                android:id="@+id/btnKaraoke"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Karaoke"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_karaoke_mic"
                app:tint="#FFFFFF" />

            <!-- Equalizer/Settings icon from proposal -->
            <ImageButton
                android:id="@+id/btnEqualizer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_rotate"
                app:tint="#FFFFFF" />

            <androidx.mediarouter.app.MediaRouteButton
                android:id="@+id/btnCast"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Etiqueta superior: quitada a peticion del usuario (ya no se muestra
             la palabra "REPRODUCIENDO" en el reproductor a pantalla completa). -->
    </RelativeLayout>

    <!-- Secondary Row of Actions (6 green circular buttons from proposal) -->
    <LinearLayout
        android:id="@+id/llSecondaryActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/rlTopBar">

        <ImageButton
            android:id="@+id/btnRadio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#1DB954"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_radio"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#1DB954"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mic"
            android:visibility="gone"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btnAddToPlaylist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#1DB954"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_collections"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btnFullEditMetadata"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#1DB954"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_metadata"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btnLyrics"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#1DB954"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lyrics_sheet"
            app:tint="#000000" />

        <!-- Solo visible para administradores (NowPlayingActivity lo activa). -->
        <ImageButton
            android:id="@+id/btnEditLyrics"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#1DB954"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lyrics_sheet"
            android:visibility="gone"
            app:tint="#000000" />

        <ImageButton
            android:id="@+id/btnDeleteSong"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#FF4444"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVoiceIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_comment_input"
        android:backgroundTint="#FF5252"
        android:drawableStart="@drawable/ic_mic"
        android:drawablePadding="6dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="DJ HABLANDO"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:drawableTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llSecondaryActionsRow" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCircularImage"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginTop="20dp"
        android:scaleType="centerCrop"
        android:elevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvVoiceIndicator"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:strokeColor="#1DB954"
        app:strokeWidth="2dp" />

    <!-- Info de la cancion container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llTrackInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/ivCircularImage">

        <LinearLayout
            android:id="@+id/llTrackInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/llLikeDislikeActions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvFullTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Titulo de la pista"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvFullArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nombre del Artista"
                android:textColor="#1DB954"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tvAlbumYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Album - 2024"
                android:textColor="#8A8A8A"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llLikeDislikeActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnFullLike"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="#22FFFFFF"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_like_off"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnFullDislike"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="#22FFFFFF"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_dislike_off"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layoutRatingStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="24dp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llTrackInfoContainer">

        <RatingBar
            android:id="@+id/rbSongAvg"
            style="@android:style/Widget.DeviceDefault.RatingBar.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.1"
            android:progressTint="#1DB954"
            android:theme="@style/RatingBarGreen" />

        <TextView
            android:id="@+id/tvRatingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#B3B3B3"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Area de Transcripcion Automatica (podcast) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTranscript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#1AFFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/waveformSeekBar"
        app:layout_constraintTop_toBottomOf="@id/layoutRatingStats">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTranscriptInline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false" />
    </androidx.cardview.widget.CardView>

    <com.masoudss.lib.WaveformSeekBar
        android:id="@+id/waveformSeekBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/tvCurrentTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:wave_background_color="#2EFFFFFF"
        app:wave_corner_radius="3dp"
        app:wave_gap="3dp"
        app:wave_gravity="center"
        app:wave_min_height="6dp"
        app:wave_progress_color="#1DB954"
        app:wave_width="3dp" />

    <TextView
        android:id="@+id/tvCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/llControls"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/llControls"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/llControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Shuffle button (Crossed arrows) -->
        <ImageButton
            android:id="@+id/btnRepeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnFullPrev"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#FFFFFF" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp">
            <View
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_green"
                android:elevation="4dp" />
            <ImageButton
                android:id="@+id/btnFullPlayPause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:elevation="6dp"
                android:padding="22dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_play"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnFullNext"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            app:tint="#FFFFFF" />

        <!-- Queue button (List) -->
        <ImageButton
            android:id="@+id/btnShowQueueTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Panel de cola de reproduccion -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/queueOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_queue_panel"
        android:visibility="gone"
        android:elevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/rlTopBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivQueueMiniThumb"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvQueueMiniInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/ivQueueMiniThumb"
            app:layout_constraintEnd_toStartOf="@id/btnCloseQueueOverlay"
            app:layout_constraintTop_toTopOf="@id/ivQueueMiniThumb"
            app:layout_constraintBottom_toBottomOf="@id/ivQueueMiniThumb" />

        <ImageButton
            android:id="@+id/btnCloseQueueOverlay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/arrow_down_float"
            app:layout_constraintBottom_toBottomOf="@id/ivQueueMiniThumb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivQueueMiniThumb"
            app:tint="#FFFFFF" />

        <View
            android:id="@+id/dividerQueue"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="#22FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/ivQueueMiniThumb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvUpcomingHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="18dp"
            android:text="COLA DE REPRODUCCION"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerQueue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSmartReorder"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="DJ Smart"
            android:textColor="#1DB954"
            android:textSize="11sp"
            app:icon="@drawable/ic_sparkles"
            app:iconSize="14dp"
            app:iconTint="#1DB954"
            app:layout_constraintBottom_toBottomOf="@id/tvUpcomingHeader"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvUpcomingHeader" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUpcomingSongs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvUpcomingHeader" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
