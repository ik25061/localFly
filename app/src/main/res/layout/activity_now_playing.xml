<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/ivBlurredBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45" />

    <View
        android:id="@+id/backgroundScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_now_playing_scrim" />

    <ImageView
        android:id="@+id/ivPodcastHeader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vPodcastGradient"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_podcast_scrim"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivPodcastHeader"
        app:layout_constraintTop_toTopOf="@id/ivPodcastHeader" />

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_circle_white"
        android:backgroundTint="#26000000"
        android:elevation="2dp"
        android:src="@android:drawable/arrow_down_float"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/tvHeaderType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REPRODUCIENDO"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        android:alpha="0.92"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llActionsPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnRadio"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#22000000"
            android:contentDescription="@string/radio_live"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_radio"
            app:tint="#FFFFFF" />

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/btnCast"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#22000000" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llActionsSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llActionsPrimary">

        <ImageButton
            android:id="@+id/btnComments"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#22000000"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_comment"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnFullEditMetadata"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#22000000"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_metadata"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnAddToPlaylist"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#22000000"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_collections"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnEditLyrics"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#22000000"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lyrics_sheet"
            app:tint="#FFFFFF"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnLyrics"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#22000000"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lyrics_sheet"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnDeleteSong"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#22000000"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            app:tint="#FF6B6B" />
    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCircularImage"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="18dp"
        android:scaleType="centerCrop"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llActionsSecondary"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:strokeColor="#26FFFFFF"
        app:strokeWidth="1dp" />

    <!-- Info de la cancion -->
    <LinearLayout
        android:id="@+id/llTrackInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/ivCircularImage">

        <TextView
            android:id="@+id/tvFullTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titulo de la pista"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginEnd="56dp" />

        <TextView
            android:id="@+id/tvFullArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nombre del Artista"
            android:textColor="#1DB954"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tvAlbumYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Album - 2024"
            android:textColor="#8A8A8A"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutRatingStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <RatingBar
                android:id="@+id/rbSongAvg"
                style="@android:style/Widget.DeviceDefault.RatingBar.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="0.1"
                android:progressTint="#1DB954"
                android:theme="@style/RatingBarGreen" />

            <TextView
                android:id="@+id/tvRatingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#B3B3B3"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnFullLike"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_like_off"
        app:layout_constraintBottom_toTopOf="@id/rbSongAvg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvFullTitle"
        app:tint="#FFFFFF" />

    <ImageButton
        android:id="@+id/btnFullDislike"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_dislike_off"
        app:layout_constraintBottom_toTopOf="@id/rbSongAvg"
        app:layout_constraintEnd_toStartOf="@id/btnFullLike"
        app:layout_constraintTop_toTopOf="@id/tvFullTitle"
        app:tint="#FFFFFF"
        android:visibility="gone" />

    <!-- Area de Transcripcion Automatica (podcast) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTranscript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#1AFFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/waveformSeekBar"
        app:layout_constraintTop_toBottomOf="@id/llTrackInfo">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTranscriptInline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false" />
    </androidx.cardview.widget.CardView>

    <com.masoudss.lib.WaveformSeekBar
        android:id="@+id/waveformSeekBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toTopOf="@id/tvCurrentTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:wave_background_color="#2EFFFFFF"
        app:wave_corner_radius="3dp"
        app:wave_gap="3dp"
        app:wave_gravity="center"
        app:wave_min_height="6dp"
        app:wave_progress_color="#1DB954"
        app:wave_width="3dp" />

    <TextView
        android:id="@+id/tvCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="16dp"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/llControls"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/llControls"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/llControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnRepeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#AAAAAA" />

        <ImageButton
            android:id="@+id/btnFullPrev"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnFullPlayPause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_circle_green"
            android:elevation="6dp"
            android:padding="22dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_play"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnFullNext"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnShowQueueTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#FFFFFF"
            android:rotation="180" />
    </LinearLayout>

    <!-- Panel de cola de reproduccion -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/queueOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_queue_panel"
        android:visibility="gone"
        android:elevation="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnClose"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivQueueMiniThumb"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvQueueMiniInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/ivQueueMiniThumb"
            app:layout_constraintEnd_toStartOf="@id/btnCloseQueueOverlay"
            app:layout_constraintTop_toTopOf="@id/ivQueueMiniThumb"
            app:layout_constraintBottom_toBottomOf="@id/ivQueueMiniThumb" />

        <ImageButton
            android:id="@+id/btnCloseQueueOverlay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/arrow_down_float"
            app:layout_constraintBottom_toBottomOf="@id/ivQueueMiniThumb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivQueueMiniThumb"
            app:tint="#FFFFFF" />

        <View
            android:id="@+id/dividerQueue"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="#22FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/ivQueueMiniThumb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvUpcomingHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="18dp"
            android:text="COLA DE REPRODUCCION"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerQueue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSmartReorder"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="DJ Smart"
            android:textColor="#1DB954"
            android:textSize="11sp"
            app:icon="@drawable/ic_sparkles"
            app:iconSize="14dp"
            app:iconTint="#1DB954"
            app:layout_constraintBottom_toBottomOf="@id/tvUpcomingHeader"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvUpcomingHeader" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUpcomingSongs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvUpcomingHeader" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
