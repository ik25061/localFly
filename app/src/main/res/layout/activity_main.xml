<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- Banner de reescaneo -->
    <LinearLayout
        android:id="@+id/layoutRescanProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1DB954"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvRescanMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reescaneando sistema..."
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ProgressBar
            android:id="@+id/pbRescan"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:progress="0"
            android:progressTint="#000000"
            android:progressBackgroundTint="#33000000" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Mini reproductor (ya existente) -->
    <include
        android:id="@+id/miniPlayer"
        layout="@layout/mini_player" />

    <!-- Barra de navegación inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="8dp"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        android:background="#17171B"
        app:labelVisibilityMode="labeled"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:shapeAppearanceOverlay="@style/RoundedCorners8"
        app:cardElevation="0dp" />

</LinearLayout>