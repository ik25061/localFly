<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="4dp"
    android:paddingHorizontal="4dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvSongIndex"
        android:layout_width="16dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="#888888"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#1DB954"
            app:shapeAppearanceOverlay="@style/RoundedCorners4"
            android:contentDescription="@string/cover_placeholder" />

        <ImageView
            android:id="@+id/ivLyricsIndicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="2dp"
            android:src="@drawable/ic_lyrics_sheet"
            android:visibility="gone"
            android:padding="2dp"
            android:background="@drawable/bg_lyrics_indicator"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSongArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Acciones visibles: Me gusta, No me gusta y menú (hamburguesa).
         Las acciones restantes (Eliminar, Añadir a la lista de reproducción,
         Reproducir siguiente, Descargar) están anidadas en el menú. -->

    <ImageButton
        android:id="@+id/btnLike"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_like_off"
        android:scaleType="centerInside" />

    <ImageButton
        android:id="@+id/btnDislike"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_dislike_off"
        android:scaleType="centerInside" />

    <ImageButton
        android:id="@+id/btnSongMenu"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_menu"
        android:scaleType="centerInside"
        android:contentDescription="@string/song_menu" />

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="3:30"
        android:textColor="#AAAAAA"
        android:textSize="12sp" />

</LinearLayout>