<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rellenado automático de descargas"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Elige qué canciones se descargan solas cuando la app está conectada al servidor (priorizando tus gustos)."
            android:textColor="#BBFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvAutoDownloadCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#1DB954"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/optAutoNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Solo novedades (no escuchadas)"
            android:textAllCaps="false"
            app:icon="@drawable/ic_sparkles"
            app:cornerRadius="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Baja solo canciones que todavía no escuchaste. Cuando las completes, se vuelve a empezar con todo el catálogo de forma aleatoria."
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/optAutoLiked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mis canciones favoritas (con like)"
            android:textAllCaps="false"
            app:icon="@drawable/ic_like_on"
            app:cornerRadius="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Baja las canciones que ya te gustan para escucharlas sin conexión."
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>