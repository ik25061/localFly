<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDisliked"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#1F1F23"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#1AFFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Play Button: transparente, sin fondo de color y con el dibujo blanco -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayDisliked"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:icon="@android:drawable/ic_media_play"
                app:iconTint="#FFFFFF"
                android:contentDescription="@string/notification_play" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDlSongTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvDlSongArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Estado de revisión: pendiente (rojo) o dejada (verde). Es la
                     señal de que la canción ya fue revisada y NO se borrará. -->
                <TextView
                    android:id="@+id/tvDlStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FF6B6B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="end">

            <!-- Boton "Dejar": marca la cancion como revisada (no se borrara).
                 Para las ya revisadas el mismo boton la devuelve a revision. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeepSong"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dejar"
                android:textAllCaps="false"
                android:textColor="#6BCB77"
                android:textSize="12sp"
                app:strokeColor="#6BCB77"
                app:cornerRadius="12dp" />

            <!-- Boton "Quitar": gris y discreto -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveFromList"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Quitar de lista"
                android:textAllCaps="false"
                android:textColor="#A8A8AF"
                android:textSize="12sp" />

            <!-- "Eliminar" button: Solid red and clear -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteFromDisk"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Borrar del Servidor"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#FF4444"
                app:cornerRadius="12dp"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
