<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="100dp">

        <!-- Header: Saludo y Ajustes -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="8dp"
            android:background="#15181F"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buenos días"
                    android:textColor="#9EA3AD"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu Música"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnNotifications"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_white"
                    android:backgroundTint="#1AFFFFFF"
                    android:src="@android:drawable/ic_popup_reminder"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="12dp" />

                <FrameLayout
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_white"
                    android:backgroundTint="#1DB954">
                    <TextView
                        android:id="@+id/tvSettingsAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="U"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Moods Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="12dp"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/layoutHomeMoods"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- [PROMOCIÓN] Canciones que te gustan (VERTICAL, EN EL TOP) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Canciones que te gustan"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvSeeAllLiked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Ver todo"
                    android:textColor="#1DB954"
                    android:textSize="13sp" />
            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLikedSongs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- Featured Card -->
        <include
            android:id="@+id/cardFeatured"
            layout="@layout/item_home_featured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="24dp" />

        <!-- Category Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:clipToPadding="false">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupHomeCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true" />
        </HorizontalScrollView>

        <!-- Continuar Podcast -->
        <include layout="@layout/include_continue_podcast" android:id="@+id/layoutContinuePodcast" android:visibility="gone" />

        <include layout="@layout/section_home_standard" android:id="@+id/sectionPlaylists" />
        <include layout="@layout/section_home_standard" android:id="@+id/sectionPodcasts" />
        <include layout="@layout/section_home_standard" android:id="@+id/sectionAlbums" />
        <include layout="@layout/section_home_standard" android:id="@+id/sectionArtists" />
        <include layout="@layout/section_home_standard" android:id="@+id/sectionGenres" />
        <include layout="@layout/section_home_standard" android:id="@+id/sectionYears" />
        <include layout="@layout/section_home_standard" android:id="@+id/sectionRecommendations" />
        <include layout="@layout/section_home_standard" android:id="@+id/sectionLibrary" />

    </LinearLayout>
</ScrollView>
