<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayer"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginHorizontal="10dp"
    android:layout_marginBottom="8dp"
    android:backgroundTint="#1A1A1E"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeColor="#32FFFFFF"
    app:strokeWidth="1dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMiniCover"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedCorners4" />

        <LinearLayout
            android:id="@+id/miniPlayerInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNowPlayingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="La Tragedia de los Ayones"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvNowPlayingArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Larry Hernandez"
                android:textColor="#A7A7A7"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMiniLike"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_like_off"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#232631"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnMiniDislike"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_dislike_off"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#232631"
            app:tint="#FFFFFF" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@android:drawable/ic_media_play"
                android:background="@drawable/bg_circle_green"
                android:padding="10dp"
                android:scaleType="centerInside"
                app:tint="#000000" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:src="@android:drawable/ic_media_next"
            android:background="@drawable/bg_circle_white"
            android:backgroundTint="#232631"
            app:tint="#FFFFFF" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>