<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayer"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="#121212"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:elevation="8dp"
    android:visibility="gone">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivMiniCover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_placeholder"
        app:shapeAppearanceOverlay="@style/RoundedCorners4" />

    <LinearLayout
        android:id="@+id/miniPlayerInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvNowPlayingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="La Tragedia de los Ayones"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="marquee" />

        <TextView
            android:id="@+id/tvNowPlayingArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Larry Hernandez"
            android:textColor="#A7A7A7"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMiniLike"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_like_off"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#FFFFFF" />

    <ImageButton
        android:id="@+id/btnMiniDislike"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_dislike"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#FFFFFF" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp">

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_media_play"
            android:background="@drawable/bg_circle_green"
            android:padding="10dp"
            android:scaleType="centerInside"
            app:tint="#000000" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnNext"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_media_next"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#FFFFFF" />

</LinearLayout>